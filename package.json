{
  "name": "road-to-hsk4",
  "productName": "Road to HSK",
  "version": "2.0.0",
  "description": "Chinese study app: Integrated Chinese Lessons 1-20, HSK 1-2, stroke order, handwriting recognition, listening, reading, translation and grammar",
  "main": "main.js",
  "author": "Isaac",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.isaac.roadtohsk4",
    "productName": "Road to HSK",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "js/**",
      "data/**",
      "vendor/**",
      "licenses/**",
      "build/icon.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Jefest1",
        "repo": "road-to-hsk4",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Road to HSK Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Road to HSK"
    }
  }
}
